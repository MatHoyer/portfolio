# GitHub personal access token with read:user and public_repo scopes.
# Required at build time to fetch profile and repository data.
# NEVER commit a real token — rotate any token that was previously committed.
GITHUB_TOKEN=ghp_your_token_here

# Fallback contact email when GitHub profile email is unavailable (also used on /contact-me)
EMAIL=you@example.com

# Optional: canonical site URL for hreflang metadata (defaults to https://mathoyer.dev)
# NEXT_PUBLIC_SITE_URL=https://mathoyer.dev

# App version shown on the home page (local dev defaults to package.json version)
# APP_VERSION=1.0.0
